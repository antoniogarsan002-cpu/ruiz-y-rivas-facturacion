rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function namedAdmin() {
      return signedIn() && request.auth.token.email == 'agarcia@rconsultores.es';
    }

    function member(companyId) {
      return signedIn() && exists(
        /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)
      );
    }

    function admin(companyId) {
      return member(companyId) && get(
        /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)
      ).data.role == 'admin';
    }

    function manager(companyId) {
      return member(companyId) && get(
        /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)
      ).data.role in ['admin', 'manager'];
    }

    // Transición segura para la versión actual de la app.
    // Debe mantenerse solo mientras se migra appData a companies/{companyId}/...
    match /appData/ruiz_rivas_facturacion {
      allow read: if signedIn();
      // Solo el administrador puede crear o borrar el documento principal.
      allow create, delete: if namedAdmin();
      // Los usuarios pueden trabajar con los registros, pero no cambiar
      // configuración ni reducir las colecciones para borrar datos.
      allow update: if namedAdmin() || (
        request.resource.data.settings == resource.data.settings &&
        request.resource.data.clients.size() >= resource.data.clients.size() &&
        request.resource.data.products.size() >= resource.data.products.size() &&
        request.resource.data.invoices.size() >= resource.data.invoices.size() &&
        request.resource.data.quotes.size() >= resource.data.quotes.size() &&
        request.resource.data.expenses.size() >= resource.data.expenses.size() &&
        request.resource.data.accounts.size() >= resource.data.accounts.size() &&
        request.resource.data.remittances.size() >= resource.data.remittances.size()
      );
    }

    match /companies/{companyId} {
      allow read: if member(companyId);
      allow write: if admin(companyId);
    }

    match /companies/{companyId}/members/{uid} {
      allow read: if member(companyId);
      allow create, update: if admin(companyId);
      allow delete: if false;
    }

    match /companies/{companyId}/invoices/{invoiceId} {
      allow read: if member(companyId);
      allow create, update: if manager(companyId);
      allow delete: if false;
    }

    match /companies/{companyId}/clients/{docId} {
      allow read: if member(companyId);
      allow create, update: if manager(companyId);
      allow delete: if admin(companyId);
    }

    match /companies/{companyId}/products/{docId} {
      allow read: if member(companyId);
      allow create, update: if manager(companyId);
      allow delete: if admin(companyId);
    }

    match /companies/{companyId}/quotes/{docId} {
      allow read: if member(companyId);
      allow create, update: if manager(companyId);
      allow delete: if admin(companyId);
    }

    match /companies/{companyId}/expenses/{docId} {
      allow read: if member(companyId);
      allow create, update: if manager(companyId);
      allow delete: if admin(companyId);
    }

    match /companies/{companyId}/payments/{docId} {
      allow read: if member(companyId);
      allow create, update: if manager(companyId);
      allow delete: if admin(companyId);
    }

    match /companies/{companyId}/remittances/{docId} {
      allow read: if member(companyId);
      allow create, update: if manager(companyId);
      allow delete: if false;
    }

    match /companies/{companyId}/audit/{docId} {
      allow read: if member(companyId);
      allow create: if manager(companyId);
      allow update, delete: if false;
    }
  }
}
